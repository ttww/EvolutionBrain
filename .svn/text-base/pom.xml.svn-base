<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.EvolutionBrain</groupId>
	<artifactId>EvolutionBrain</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>EvolutionBrain</name>
	<description>Neuronal evolution driven by mutation and selection
	</description>

	<parent>
		<groupId>com.spontech</groupId>
		<artifactId>base-pom</artifactId>
		<version>1.5.5</version>
	</parent>


	<distributionManagement>
		<site>
			<id>site</id>
			<url>dav:http://develop.spontech-spine.com/site/EvolutionBrain</url>
		</site>
		<repository>
			<id>site</id>
		</repository>
	</distributionManagement>

	<!-- tw: This is for the mvn scm:bootstrap, part 1/2 -->
	<scm>
		<connection>scm:svn:http://develop.spontech-spine.com/repo/develop/EvolutionBrain/</connection>
		<developerConnection>scm:svn:http://develop.spontech-spine.com/repo/develop/EvolutionBrain/</developerConnection>
		<url>http://develop.spontech-spine.com/repo/develop/EvolutionBrain/</url>
	</scm>


	<dependencies>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jogl.all</artifactId>
			<version>09.04.2011</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>gluegen-rt</artifactId>
			<version>09.04.2011</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jocl</artifactId>
			<version>09.04.2011</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>nativewindow.all</artifactId>
			<version>09.04.2011</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jmdns</artifactId>
			<version>09.04.2011</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jogl-native</artifactId>
			<version>09.04.2011</version>
			<classifier>${build.type}</classifier>
		</dependency>

		<dependency>
			<groupId>org.easytesting</groupId>
			<artifactId>fest-swing</artifactId>
			<version>1.2</version>
		</dependency>
	</dependencies>


	<build>

		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.2</version>
				<executions>
					<execution>
						<id>unpack</id>
						<phase>compile</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.EvolutionBrain</groupId>
									<artifactId>jogl-native</artifactId>
									<version>09.04.2011</version>
									<classifier>${build.type}</classifier>
									<type>jar</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/lib
									</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
