<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.EvolutionBrain</groupId>
	<artifactId>EvolutionBrain</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>EvolutionBrain</name>
	<description>Neuronal evolution driven by mutation and selection
	</description>


	<pluginRepositories>
		<pluginRepository>
			<id>codehaus-snapshot</id>
			<name>Snapshot codehaus repository</name>
			<url>http://snapshots.repository.codehaus.org</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<!-- <repositories> <repository> <id>FINDBUGS</id> <url>http://snapshots.repository.codehaus.org</url> 
		<name>Findbugs SNAPSHOT Repository</name> <layout>default</layout> <snapshots> 
		<enabled>true</enabled> </snapshots> </repository> </repositories> -->


	<!-- This has to go to ~/.m2/settings.xml !!! <servers> <server> <id>EvolutionBrain</id> 
		<username>site</username> <password>site</password> <directoryPermissions>0775</directoryPermissions> 
		<filePermissions>0664</filePermissions> </server> </servers> -->
	<distributionManagement>
		<site>
			<id>EvolutionBrain</id>
			<url>dav:http://develop.spontech-spine.com/site/EvolutionBrain</url>
		</site>
		<repository>
			<id>EvolutionBrain</id>
			<url>dav:http://develop.spontech-spine.com/maven</url>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>utf-8</project.reporting.outputEncoding>
		<targetJdk>1.6</targetJdk>
	</properties>



	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>2.7.2</version>
				<configuration>
					<!-- place your configuration here -->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jxr-plugin</artifactId>
				<version>2.1</version>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>findbugs-maven-plugin</artifactId>
				<!-- Using the 2.3.2-SNAPSHOT version, 2.3.1 is buggy.... -->
				<!-- Findbugs currently not working under maven 3 ! -->
				<version>2.3.2-SNAPSHOT</version>
				<configuration>
					<xmlOutput>true</xmlOutput>
					<!-- Optional directory to put findbugs xdoc xml report -->
					<xmlOutputDirectory>xxx/target/site</xmlOutputDirectory>
				</configuration>

			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>cobertura-maven-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<formats>
						<format>html</format>
						<format>xml</format>
					</formats>
				</configuration>

			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>2.5</version>
				<configuration>
					<formats>
						<format>html</format>
						<format>xml</format>
						<linkXref>true</linkXref>
					</formats>
				</configuration>
			</plugin>

		</plugins>

	</reporting>
	<!-- <reports> <report>maven-faq-plugin</report> <report>maven-pmd-plugin</report> 
		</reports> -->

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.8.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jogl.all</artifactId>
			<version>unknown</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>gluegen-rt</artifactId>
			<version>unknown</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jocl</artifactId>
			<version>unknown</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>nativewindow.all</artifactId>
			<version>unknown</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jmdns</artifactId>
			<version>unknown</version>
		</dependency>
		<dependency>
			<groupId>com.EvolutionBrain</groupId>
			<artifactId>jogl-native</artifactId>
			<version>unknown</version>
			<classifier>${build.type}</classifier>
		</dependency>
		<!-- <dependency> <groupId>org.sonatype.aether</groupId> <artifactId>aether-connector-wagon</artifactId> 
			<version>1.7</version> </dependency> <dependency> <groupId>org.apache.maven.wagon</groupId> 
			<artifactId>wagon-http</artifactId> <version>1.0-beta-6</version> </dependency> -->
	</dependencies>


	<url>http://develop.spontech-spine.com</url>


	<build>

		<!-- <resources> <resource> <directory>lib/arch</directory> </resource> 
			</resources> -->

		<extensions>

			<!-- For deployment Part 2/2: -->
			<!-- See http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=573482 -->

			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-webdav-jackrabbit</artifactId>
				<version>1.0-beta-7</version>
			</extension>
		</extensions>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>2.3.2</version>
				<configuration>
					<source>1.6</source>
					<target>1.6</target>
					<!-- <encoding>utf-8</encoding> -->
					<optimize>false</optimize>
					<!-- <debug>true</debug> <debuglevel>vars,lines,source</debuglevel> -->
				</configuration>
			</plugin>

			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>2.7</version>
			</plugin>

			<plugin>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>2.5</version>
				<configuration>
					<targetJdk>1.6</targetJdk>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.2</version>
				<executions>
					<execution>
						<id>unpack</id>
						<phase>compile</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.EvolutionBrain</groupId>
									<artifactId>jogl-native</artifactId>
									<version>unknown</version>
									<classifier>${build.type}</classifier>
									<type>jar</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/lib
									</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>2.7.2</version>
				<configuration>
					<argLine>-Djava.library.path=${project.build.directory}/lib/
					</argLine>
				</configuration>
			</plugin>
			<!-- <plugin> <groupId>org.apache.maven.plugins</groupId> <artifactId>maven-pmd-plugin</artifactId> 
				<version>2.5</version> </plugin> -->

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>cobertura-maven-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<instrumentation>
						<ignores>
							<!-- <ignore>com.example.boringcode.*</ignore> -->
						</ignores>
						<excludes>
							<!--<exclude>com/example/dullcode/**/*.class</exclude> -->
							<!--<exclude>com/example/**/*Test.class</exclude> -->
						</excludes>
					</instrumentation>
					<check>
						<branchRate>0</branchRate>
						<lineRate>0</lineRate>
						<haltOnFailure>true</haltOnFailure>
						<totalBranchRate>0</totalBranchRate>
						<totalLineRate>0</totalLineRate>
						<packageLineRate>0</packageLineRate>
						<packageBranchRate>0</packageBranchRate>
						<regexes>
							<regex>
								<pattern>com.example.reallyimportant.*</pattern>
								<branchRate>90</branchRate>
								<lineRate>80</lineRate>
							</regex>
							<regex>
								<pattern>com.example.boringcode.*</pattern>
								<branchRate>40</branchRate>
								<lineRate>30</lineRate>
							</regex>
						</regexes>
					</check>
				</configuration>

				<executions>
					<execution>
						<goals>
							<goal>clean</goal>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>

			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>findbugs-maven-plugin</artifactId>
				<version>2.3.1</version>
				<configuration>
					<threshold>High</threshold>
					<effort>Default</effort>
				</configuration>
			</plugin>

			<!-- For deployment Part 2/2: -->
			<!-- See http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=573482 -->
			<plugin>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.0</version>
			</plugin>


		</plugins>
	</build>

	<!-- Build Type -->
	<!-- See http://maven.apache.org/plugins/maven-enforcer-plugin/rules/requireOS.html 
		and http://lopica.sourceforge.net/os.html and http://javablog.co.uk/2007/05/19/making-jni-cross-platform/ -->
	<profiles>
		<profile>
			<id>win32</id>
			<activation>
				<os>
					<family>windows</family>
					<arch>x86</arch>
				</os>
			</activation>
			<properties>
				<build.type>windows-i586</build.type>
			</properties>
		</profile>
		<profile>
			<id>win64_a</id>
			<activation>
				<os>
					<family>windows</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<properties>
				<build.type>windows-amd64</build.type>
			</properties>
		</profile>
		<profile>
			<id>win64_b</id>
			<activation>
				<os>
					<family>windows</family>
					<arch>x86_64</arch>
				</os>
			</activation>
			<properties>
				<build.type>windows-amd64</build.type>
			</properties>
		</profile>
		<profile>
			<id>linux32_a</id>
			<activation>
				<os>
					<family>unix</family>
					<arch>i386</arch>
				</os>
			</activation>
			<properties>
				<build.type>linux-i586</build.type>
			</properties>
		</profile>
		<profile>
			<id>linux32_b</id>
			<activation>
				<os>
					<family>unix</family>
					<arch>i586</arch>
				</os>
			</activation>
			<properties>
				<build.type>linux-i586</build.type>
			</properties>
		</profile>
		<profile>
			<id>linux64_a</id>
			<activation>
				<os>
					<family>unix</family>
					<arch>amd64</arch>
				</os>
			</activation>
			<properties>
				<build.type>linux-amd64</build.type>
			</properties>
		</profile>
		<profile>
			<id>linux64_b</id>
			<activation>
				<os>
					<family>unix</family>
					<arch>x86_64</arch>
				</os>
			</activation>
			<properties>
				<build.type>linux-amd64</build.type>
			</properties>
		</profile>
		<profile>
			<id>macosx</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<properties>
				<build.type>macosx-universal</build.type>
			</properties>
		</profile>
	</profiles>

</project>
