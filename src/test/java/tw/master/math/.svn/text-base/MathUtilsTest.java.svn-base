    /**
     * Test method for {@link tw.master.math.MathUtils#equals_0_00001(double, double)}.
     */
    @Test
    public void testEquals_0_00001() {
        assertTrue(MathUtils.equals_0_00001(0f, 0f));
        assertTrue(MathUtils.equals_0_00001(0f, 0.00001f));
        assertFalse(MathUtils.equals_0_00001(0f, 0.00002f));
    }

